#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    double data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    double A;
} pc;

// Chain shape and why: see the MAD chain block in include/common/common.h.
#define MAD_4(x, c)  x = fma(x, x, c); x = fma(x, x, c); x = fma(x, x, c); x = fma(x, x, c);
#define MAD_16(x, c) MAD_4(x, c) MAD_4(x, c) MAD_4(x, c) MAD_4(x, c)

void main()
{
    dvec2 x = dvec2(pc.A, pc.A + 1.0lf);
    dvec2 c = dvec2(gl_LocalInvocationID.x);

    // 8 iters * 16 FMAs * 2 ops * 2 lanes = 512 per WI (matches COMPUTE_DP_WORK_PER_WI).
    for (int i = 0; i < 8; i++)
    {
        MAD_16(x, c)
    }

    outputBuf.data[gl_GlobalInvocationID.x] = x.x + x.y;
}
