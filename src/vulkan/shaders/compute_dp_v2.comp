#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_GOOGLE_include_directive : require

// Double-precision MAC: fp64 x fp64 + fp64.  Requires shaderFloat64.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    double data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    double A;
} pc;

// Compiled twice -- squaring chain and affine chain -- and raced against
// each other at run time.  See mad_chain.glsl, and the MAD chain block in
// include/common/common.h for the rules both shapes obey.
#define MAD_CHAINS 2
#include "mad_chain.glsl"

void main()
{
    CHAIN_DECL(dvec2, dvec2(pc.A, pc.A + 1.0lf), dvec2(gl_LocalInvocationID.x))

    // 16 iters * 16 FMAs * 2 ops = 512 per WI (COMPUTE_DP_WORK_PER_WI).
    for (int i = 0; i < 8; i++)
    {
        MAD_16
    }

    dvec2 r = CHAIN_RESULT;
    outputBuf.data[gl_GlobalInvocationID.x] = r.x + r.y;
}
