#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_GOOGLE_include_directive : require

// INT8 packed-dp4a v4: four independent dot-product chains per thread.
// See dp4a_chain.glsl for the chain shape and why every other spelling of it
// is wrong.  v4 doubles v2's independent work per thread, letting the
// scheduler hide more dp4a latency at the cost of register pressure -- if
// occupancy drops, v2 is faster.
//
// Per-WI op budget: 64 iters * 16 dots * 8 ops = 8192 (same as v1/v2).

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    int data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    int A;
} pc;

#include "dp4a_chain.glsl"

void main()
{
    DP_DECL_X(pc.A)
    int lid = int(gl_LocalInvocationID.x);
    DP_CHAIN_DECL(0, lid)
    DP_CHAIN_DECL(1, lid + DP_CHAIN_STRIDE)
    DP_CHAIN_DECL(2, lid + 2 * DP_CHAIN_STRIDE)
    DP_CHAIN_DECL(3, lid + 3 * DP_CHAIN_STRIDE)

    // 16 iters * (16 dots per chain * 4 chains) = 1024 dots.  Depth per trip:
    // see v1.
    for (int i = 0; i < 16; i++)
    {
        DP_CHAIN_16(0) DP_CHAIN_16(1) DP_CHAIN_16(2) DP_CHAIN_16(3)
    }

    outputBuf.data[gl_GlobalInvocationID.x] =
        (DP_CHAIN_SUM(0) + DP_CHAIN_SUM(1)) + (DP_CHAIN_SUM(2) + DP_CHAIN_SUM(3));
}
