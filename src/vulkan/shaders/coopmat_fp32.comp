#version 450
#extension GL_KHR_cooperative_matrix       : require
#extension GL_KHR_memory_scope_semantics   : require

// Cooperative-matrix FP32 x FP32 + FP32 accumulator.  Rare -- only a few
// drivers advertise an fp32 tile -- but where it exists it is the only
// tensor-core row that needs no narrowing of the inputs.  See
// coopmat_chain.glsl for the shape of the MulAdd run and coopmat_fp16.comp
// for how M/N/K reach the shader.

layout(local_size_x_id = 3, local_size_x = 32) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
    int   trips;
} pc;

layout(constant_id = 0) const uint M = 16u;
layout(constant_id = 1) const uint N = 16u;
layout(constant_id = 2) const uint K = 16u;

#define CM_AB     float
#define CM_ACC    float
#define CM_VAL(i) (pc.A + float(i))
#include "coopmat_chain.glsl"

void main()
{
    CM_DECLARE

    for (int i = 0; i < pc.trips; i++)
    {
        CM_MMA_TRIP
    }

    coopMatStore(matC, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
