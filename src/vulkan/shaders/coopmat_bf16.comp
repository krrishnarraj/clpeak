#version 450
#extension GL_KHR_cooperative_matrix     : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_bfloat16               : require

// Cooperative-matrix BF16 x BF16 + FP32 accumulator (tensor-core BF16).
// Requires VK_KHR_cooperative_matrix + VK_KHR_shader_bfloat16, and a
// matching property advertised by the driver.  See coopmat_fp16.comp for
// design notes (spec-constant tile; single accumulator chain); this file
// only swaps the input dtype.

// One subgroup per work-group.  The width is specialization constant 4 rather
// than a literal, so each tile runs at the subgroup width its driver actually
// advertised it at -- see the per-width query in vk_peak.cpp.
layout(local_size_x_id = 4) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
} pc;

layout(constant_id = 0) const uint M     = 16u;
layout(constant_id = 1) const uint N     = 16u;
layout(constant_id = 2) const uint K     = 16u;
layout(constant_id = 3) const int  ITERS = 256;

// MMA_PER_TRIP multiply-accumulates per loop trip rather than one.  ITERS is a
// specialization constant, so the trip count is known when the driver compiles
// the pipeline and it is free to unroll the whole loop; presenting 512 trips of
// one MulAdd rather than 32 trips of sixteen is the difference between a
// compiler unrolling a 512-deep chain and one that mostly does not.  Intel's
// Windows driver faults compiling the A380's 8x8x32 sint8 tile, and this is the
// last structural difference left against an implementation that compiles the
// same tile on the same device.  bindCoopTile keeps ITERS a multiple of this,
// so the op budget is exact either way.
#define MMA_PER_TRIP 16
#define MMA_1        matC = coopMatMulAdd(matA, matB, matC);
#define MMA_4        MMA_1 MMA_1 MMA_1 MMA_1
#define MMA_16       MMA_4 MMA_4 MMA_4 MMA_4

void main()
{
    coopmat<bfloat16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> matA =
        coopmat<bfloat16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA>(bfloat16_t(pc.A));
    coopmat<bfloat16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> matB =
        coopmat<bfloat16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB>(bfloat16_t(pc.A));
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> matC =
        coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);

    for (int i = 0; i < ITERS / MMA_PER_TRIP; i++)
    {
        MMA_16
    }

    coopMatStore(matC, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
