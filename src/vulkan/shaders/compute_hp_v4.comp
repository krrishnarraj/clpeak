#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : require

// Half-precision MAC: fp16 x fp16 + fp16 accumulator.  Distinct from
// compute_mp (fp16 x fp16 + fp32) -- some hardware only runs fp16 faster
// than fp32 when the accumulator is also fp16: NVIDIA's packed HFMA2, 2x
// on Volta and Turing (GeForce from Ampere on runs it at the FP32 rate).
// Requires VK_KHR_shader_float16_int8 + shaderFloat16.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
} pc;

// Compiled twice -- squaring chain and affine chain -- and raced against
// each other at run time.  See mad_chain.glsl, and the MAD chain block in
// include/common/common.h for the rules both shapes obey.
// fp16 accumulators pack two per 32-bit register, so these carry 8 values --
// twice the fp32 shaders' value count, the same register footprint.  See the
// MAD_CHAINS block in mad_chain.glsl for why the budget is registers.
#define MAD_CHAINS 2
#include "mad_chain.glsl"

void main()
{
    CHAIN_DECL(f16vec4, f16vec4(float16_t(pc.A),       float16_t(pc.A + 1.0),
                                float16_t(pc.A + 2.0), float16_t(pc.A + 3.0)), f16vec4(float16_t(gl_LocalInvocationID.x)))

    // 128 iters * 16 FMAs * 2 ops = 4096 per WI (COMPUTE_FP_WORK_PER_WI).
    for (int i = 0; i < 32; i++)
    {
        MAD_16
    }

    f16vec4 r = CHAIN_RESULT;
    outputBuf.data[gl_GlobalInvocationID.x] = float((r.x + r.y) + (r.z + r.w));
}
