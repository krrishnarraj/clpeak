#version 450

// Signed int32 MAC throughput.  Mirrors compute_sp_v1 with `*` + `+` in
// place of `fma` since GLSL's fma is fp-only.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    int data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    int A;
} pc;

// Chain shape and why: see the MAD chain block in include/common/common.h.
#define MAD_4(x, c)  x = (x * x) + c; x = (x * x) + c; x = (x * x) + c; x = (x * x) + c;
#define MAD_16(x, c) MAD_4(x, c) MAD_4(x, c) MAD_4(x, c) MAD_4(x, c)

void main()
{
    int x = pc.A;
    int c = int(gl_LocalInvocationID.x);

    // 64 iters * 16 MADs * 2 ops = 2048 per WI (matches COMPUTE_INT_WORK_PER_WI).
    for (int i = 0; i < 64; i++)
    {
        MAD_16(x, c)
    }

    outputBuf.data[gl_GlobalInvocationID.x] = x;
}
