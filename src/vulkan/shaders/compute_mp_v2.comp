#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : require

// Mixed-precision MAC: fp16 x fp16 + fp32 accumulator.  Dominant
// arithmetic path in LLM training/prefill.  Distinct from compute_sp
// (pure fp32) and from compute_hp (fp16 accumulator).
//
// The accumulators are loop-carried in fp32 so glslang SSA-promotes
// them to phis, and round-trip through fp16 once per outer iteration to
// force the fp16 type into the data path.  An earlier version cast
// inside the FMA macro, chaining a downcast and two expands into the
// critical path of every FMA -- that capped an RTX 5060 at ~5.7 TFLOPS,
// 27% of its FP32 rate.  The invariants are seeded through fp16 once.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
} pc;

// Compiled twice -- squaring chain and affine chain -- and raced against
// each other at run time.  See mad_chain.glsl, and the MAD chain block in
// include/common/common.h for the rules both shapes obey.
// One chain at every width, unlike the other float families.  The fp16
// round-trip below runs once per accumulator per outer iteration, so N
// chains would cost N conversions per 16 chain instructions against the
// squaring build's one -- a 19% instruction-count handicap that has
// nothing to do with the shape being measured.  Alchemist needs the
// distinct source registers, not the parallelism: a single affine chain
// already reaches 0.98 there.
#define MAD_CHAINS 1
#include "mad_chain.glsl"

#define NARROW(v) vec2(f16vec2(v))

void main()
{
    CHAIN_DECL(vec2, vec2(f16vec2(pc.A, pc.A + 1.0)), vec2(f16vec2(gl_LocalInvocationID.x)))

    // 128 iters * 16 FMAs * 2 ops = 4096 per WI (COMPUTE_FP_WORK_PER_WI).
    for (int i = 0; i < 64; i++)
    {
        MAD_16
        CHAIN_MAP(NARROW)
    }

    vec2 r = CHAIN_RESULT;
    outputBuf.data[gl_GlobalInvocationID.x] = r.x + r.y;
}
