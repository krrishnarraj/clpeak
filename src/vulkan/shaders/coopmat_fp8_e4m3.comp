#version 450
#extension GL_KHR_cooperative_matrix     : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_float_e4m3             : require

// Cooperative-matrix FP8 x FP8 + FP32 accumulator, E4M3 -- the variant that spends its bits on accuracy rather than range.
// Gated on VK_EXT_shader_float8 plus an fp8 tile in the advertised property
// list; the 8-bit types are where a driver reaches for K=32.  See
// coopmat_chain.glsl for the shape of the MulAdd run and coopmat_fp16.comp
// for how M/N/K reach the shader.

layout(local_size_x_id = 3, local_size_x = 32) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
    int   trips;
} pc;

layout(constant_id = 0) const uint M = 16u;
layout(constant_id = 1) const uint N = 16u;
layout(constant_id = 2) const uint K = 16u;

#define CM_AB     floate4m3_t
#define CM_ACC    float
#define CM_VAL(i) floate4m3_t(pc.A + float(i))
#include "coopmat_chain.glsl"

void main()
{
    CM_DECLARE

    for (int i = 0; i < pc.trips; i++)
    {
        CM_MMA_TRIP
    }

    coopMatStore(matC, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
