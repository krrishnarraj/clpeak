#version 450
#extension GL_KHR_cooperative_matrix       : require
#extension GL_KHR_memory_scope_semantics   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Cooperative-matrix FP16 x FP16 + FP16 accumulator.
//
// The same inputs as coopmat_fp16.comp with the running total kept in 16 bits
// instead of 32.  On GeForce that is a different rate, not a different
// spelling of the same one: an RTX 5060 does 42.53 TFLOPS on the fp32-
// accumulate tile and 83.38 on this one through CUDA's own WMMA, because the
// consumer parts run fp32 accumulation at half rate.  Datacenter parts and
// most other vendors run the two at the same rate, where this row simply
// agrees with coopmat_fp16.
//
// Separate module rather than a spec constant on the existing one: the
// accumulator type is part of the coopmat type, so it cannot be specialized,
// and the driver advertises the two accumulators as separate properties that
// a device may support independently.
//
// See coopmat_chain.glsl for the shape of the MulAdd run and coopmat_fp16.comp
// for how M/N/K reach the shader.

layout(local_size_x_id = 3, local_size_x = 32) in;

// fp32, even though the accumulator is fp16: the tile is converted once on the
// way out.  Storing it as fp16 would need storageBuffer16BitAccess -- a second
// feature gate on a row that is already gated on two -- to save a conversion
// that happens once per work-group against thousands of MulAdds.
layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
    int   trips;
} pc;

layout(constant_id = 0) const uint M = 16u;
layout(constant_id = 1) const uint N = 16u;
layout(constant_id = 2) const uint K = 16u;

#define CM_AB     float16_t
#define CM_ACC    float16_t
#define CM_VAL(i) float16_t(pc.A + float(i))
#include "coopmat_chain.glsl"

void main()
{
    CM_DECLARE

    for (int i = 0; i < pc.trips; i++)
    {
        CM_MMA_TRIP
    }

    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> out32 =
        coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(matC);
    coopMatStore(out32, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
