#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// TEMPORARY -- one tester round on the Arc A380, removed once it is read.
//
// vkpeak's fp16-scalar shader (nihui/vkpeak, glsl_p1_data with afp =
// float16_t), which reads 9.56 TFLOPS on a Windows A380 where our
// compute_hp_v* read 4.94.  Run inside our harness it separates "our shader"
// from "our pipeline": ncnn pins every pipeline's subgroup size to the
// device's reported one and sizes the work-group to it, and we do neither.
// Work-group width and trip count are specialization constants, as in
// vkpeak; 128 trips x 16 FMAs x 2 ops = 4096 per WI (COMPUTE_FP_WORK_PER_WI).

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const int loop = 1;

layout(set = 0, binding = 0) writeonly buffer c_blob { float c_blob_data[]; };

void main()
{
    const uint gx = gl_GlobalInvocationID.x;
    const uint lx = gl_LocalInvocationID.x;

    float16_t c = float16_t(gx);
    float16_t a = c;
    float16_t b = float16_t(lx);

    for (int i = 0; i < loop; i++)
    {
        c = a * c + b; c = a * c + b; c = a * c + b; c = a * c + b;
        c = a * c + b; c = a * c + b; c = a * c + b; c = a * c + b;
        c = a * c + b; c = a * c + b; c = a * c + b; c = a * c + b;
        c = a * c + b; c = a * c + b; c = a * c + b; c = a * c + b;
    }

    c_blob_data[gx] = float(c);
}
