#version 450
#extension GL_KHR_cooperative_matrix       : require
#extension GL_KHR_memory_scope_semantics   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Cooperative-matrix FP16 x FP16 + FP32 accumulator.
// M/N/K and the loop count ITERS arrive as specialization constants: the
// host queries vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR, picks the
// tile the driver advertises for this dtype (16x16x16 on NVIDIA/AMD/Intel
// fp16), and binds it at pipeline creation -- so this single module runs
// whatever shape the hardware exposes, and skips cleanly when none matches.
//
// One subgroup per workgroup; ITERS dependent coopMatMulAdd's keep the MMA
// observable (the compiler can't fold it away) and the final coopMatStore
// materializes the result.
//
// NOTE: this is a single accumulator chain.  On NVIDIA, fp16/bf16 coopmat
// reads ~1/4 of the CUDA WMMA tensor peak; that gap is *not* the c -> c
// dependency -- explicit multi-chain ILP (4 independent MMAs, as CUDA WMMA
// uses) was measured to make no difference on an RTX 5060, so the limit is
// NVIDIA's Vulkan cooperative-matrix code path itself.  Kept single-chain
// for simplicity; revisit with multi-chain only if AMD/Intel data shows
// their coopmat fp16 is latency-bound.

// One subgroup per work-group.  The width is specialization constant 4 rather
// than a literal, so each tile runs at the subgroup width its driver actually
// advertised it at -- see the per-width query in vk_peak.cpp.
// clpeak-alt: -DCOOPMAT_DUAL
layout(local_size_x_id = 4) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
} pc;

layout(constant_id = 0) const uint M     = 16u;
layout(constant_id = 1) const uint N     = 16u;
layout(constant_id = 2) const uint K     = 16u;
layout(constant_id = 3) const int  ITERS = 256;

void main()
{
    coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> matA =
        coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA>(float16_t(pc.A));
    coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> matB =
        coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB>(float16_t(pc.A));
#ifdef COOPMAT_DUAL
    // Two independent accumulator chains.  Intel's XMX is latency-bound on one
    // chain -- an A380 reads 12.5 TFLOPS fp16 single-chain against 25.9 for the
    // same tile with two -- while NVIDIA measured no difference either way, so
    // the pair is raced and the faster reported.  Half the trip count, two
    // MulAdds per trip: the same ITERS multiply-accumulates either way, so the
    // op budget the host credits is unchanged.
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> matC0 = coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> matC1 = coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);
#else
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> matC =
        coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);
#endif

#ifdef COOPMAT_DUAL
    for (int i = 0; i < ITERS / 2; i++)
    {
        matC0 = coopMatMulAdd(matA, matB, matC0);
        matC1 = coopMatMulAdd(matA, matB, matC1);
    }
    matC0 = matC0 + matC1;
#define matC matC0
#else
    for (int i = 0; i < ITERS; i++)
    {
        matC = coopMatMulAdd(matA, matB, matC);
    }
#endif

    coopMatStore(matC, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
