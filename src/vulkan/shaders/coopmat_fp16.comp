#version 450
#extension GL_KHR_cooperative_matrix       : require
#extension GL_KHR_memory_scope_semantics   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Cooperative-matrix FP16 x FP16 + FP32 accumulator.
// M/N/K arrive as specialization constants: the host queries
// vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR, picks the tile the driver
// advertises for this dtype (16x16x16 on NVIDIA/AMD fp16, 8x8x16 on Intel
// Alchemist), and binds it at pipeline creation -- so this single module runs
// whatever shape the hardware exposes, and skips cleanly when none matches.
//
// The MulAdd run itself, and the three things that shape it, live in
// coopmat_chain.glsl.  Everything below is the fp16 spelling of it.

// One subgroup per work-group.  The width is specialization constant 3 rather
// than a literal, so each tile runs at the subgroup width its driver actually
// advertised it at -- see the per-width query in vk_peak.cpp.  The default is
// the width every device measured so far wants, so an unspecialized load of
// this module is still a whole subgroup rather than a single thread.
layout(local_size_x_id = 3, local_size_x = 32) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
    int   trips;
} pc;

layout(constant_id = 0) const uint M = 16u;
layout(constant_id = 1) const uint N = 16u;
layout(constant_id = 2) const uint K = 16u;

#define CM_AB     float16_t
#define CM_ACC    float
#define CM_VAL(i) float16_t(pc.A + float(i))
#include "coopmat_chain.glsl"

void main()
{
    CM_DECLARE

    for (int i = 0; i < pc.trips; i++)
    {
        CM_MMA_TRIP
    }

    coopMatStore(matC, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
