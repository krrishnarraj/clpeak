#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : require

// Half-precision MAC: fp16 x fp16 + fp16 accumulator.  Distinct from
// compute_mp (fp16 x fp16 + fp32) -- some hardware (NVIDIA shader-core
// HFMA2) only reaches the 2x-FP32 rate when the accumulator is also
// fp16.  Requires VK_KHR_shader_float16_int8 + shaderFloat16.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    float data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    float A;
} pc;

// Compiled twice -- squaring chain and affine chain -- and raced against
// each other at run time.  See mad_chain.glsl, and the MAD chain block in
// include/common/common.h for the rules both shapes obey.
#define MAD_CHAINS 2
#include "mad_chain.glsl"

void main()
{
    CHAIN_DECL(f16vec2, f16vec2(float16_t(pc.A), float16_t(pc.A + 1.0)), f16vec2(float16_t(gl_LocalInvocationID.x)))

    // 128 iters * 16 FMAs * 2 ops = 4096 per WI (COMPUTE_FP_WORK_PER_WI).
    for (int i = 0; i < 64; i++)
    {
        MAD_16
    }

    f16vec2 r = CHAIN_RESULT;
    outputBuf.data[gl_GlobalInvocationID.x] = float(r.x + r.y);
}
