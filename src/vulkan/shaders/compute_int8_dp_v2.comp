#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_GOOGLE_include_directive : require

// INT8 packed-dp4a v2: two independent dot-product chains per thread.
// See dp4a_chain.glsl for the chain shape and why every other spelling of it
// is wrong.
//
// Per-WI op budget: 64 iters * 16 dots * 8 ops = 8192 (same as v1/v4).

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    int data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    int A;
} pc;

#include "dp4a_chain.glsl"

void main()
{
    DP_DECL_X(pc.A)
    // No two accumulators start on the same value: chains that begin equal
    // stay bitwise equal forever and a compiler is free to keep one.
    int lid = int(gl_LocalInvocationID.x);
    DP_CHAIN_DECL(0, lid)
    DP_CHAIN_DECL(1, lid + DP_CHAIN_STRIDE)

    // 16 iters * (32 dots per chain * 2 chains) = 1024 dots.  Depth per trip:
    // see v1.
    for (int i = 0; i < 16; i++)
    {
        DP_CHAIN_16(0) DP_CHAIN_16(1)
        DP_CHAIN_16(0) DP_CHAIN_16(1)
    }

    outputBuf.data[gl_GlobalInvocationID.x] = DP_CHAIN_SUM(0) + DP_CHAIN_SUM(1);
}
