#version 450
#extension GL_GOOGLE_include_directive : require

// Signed int32 MAC throughput.  Mirrors compute_sp with `*` + `+` in
// place of fma, which GLSL defines for floating point only.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    int data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    int A;
} pc;

// Compiled twice -- squaring chain and affine chain -- and raced against
// each other at run time.  See mad_chain.glsl, and the MAD chain block in
// include/common/common.h for the rules both shapes obey.
#define MAD_CHAIN_INTEGER
#define MAD_OP(d, m1, m2, ad)  d = (m1 * m2) + ad;
#define MAD_CHAINS 1
#include "mad_chain.glsl"

void main()
{
    CHAIN_DECL(ivec4, ivec4(pc.A, pc.A + 1, pc.A + 2, pc.A + 3), ivec4(gl_LocalInvocationID.x))

    // 64 iters * 16 MADs * 2 ops = 2048 per WI (COMPUTE_INT_WORK_PER_WI).
    for (int i = 0; i < 16; i++)
    {
        MAD_16
    }

    ivec4 r = CHAIN_RESULT;
    outputBuf.data[gl_GlobalInvocationID.x] = (r.x + r.y) + (r.z + r.w);
}
