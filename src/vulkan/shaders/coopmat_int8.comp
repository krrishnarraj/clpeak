#version 450
#extension GL_KHR_cooperative_matrix     : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

// Cooperative-matrix INT8 x INT8 + INT32 accumulator (tensor-core INT8).
// Requires VK_KHR_cooperative_matrix + shaderInt8.  See coopmat_chain.glsl
// for the shape of the MulAdd run and coopmat_fp16.comp for how M/N/K reach
// the shader.
//
// Integer accumulate is where a folded MulAdd run is not just plausible but
// exactly legal, so the sixteen distinct products and the runtime trip count
// coopmat_chain.glsl insists on matter most here.

layout(local_size_x_id = 3, local_size_x = 32) in;

layout(set = 0, binding = 0) buffer Output {
    int32_t data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    int32_t A;
    int     trips;
} pc;

layout(constant_id = 0) const uint M = 16u;
layout(constant_id = 1) const uint N = 16u;
layout(constant_id = 2) const uint K = 16u;

#define CM_AB     int8_t
#define CM_ACC    int32_t
#define CM_VAL(i) int8_t(pc.A + (i))
#include "coopmat_chain.glsl"

void main()
{
    CM_DECLARE

    for (int i = 0; i < pc.trips; i++)
    {
        CM_MMA_TRIP
    }

    coopMatStore(matC, outputBuf.data, gl_WorkGroupID.x * M * N, N,
                 gl_CooperativeMatrixLayoutRowMajor);
}
