#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Input {
    float data[];
} inputBuf;

layout(set = 0, binding = 1) writeonly buffer Output {
    float data[];
} outputBuf;

// Must match FETCH_PER_WI in common.h
#define FETCH_PER_WI 16

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    uint wid = gl_WorkGroupID.x;
    uint lsz = gl_WorkGroupSize.x;

    // Each workgroup owns a disjoint (lsz * FETCH_PER_WI)-element region of
    // the input buffer, striding by lsz so a warp's fetches stay contiguous.
    // The layout that must be avoided is the naive one, offset = gid *
    // FETCH_PER_WI + i: adjacent work-items then share 15/16 of their cache
    // lines and the benchmark measures cache bandwidth rather than VRAM.
    //
    // This mirrors OpenCL's `global_bandwidth_v1_local_offset`.  OpenCL also
    // carries a grid-stride `_global_offset` twin and races the two; that shape
    // is *not* the bad one -- it reads every element exactly once and coalesces
    // just as well -- but measured across an RTX 5060, two CPU runtimes and an
    // M1 Pro it never beats this one by more than 0.6%, while this one is up to
    // 9.5% ahead on CPUs.  Not worth a second shader here; the OpenCL race
    // stays as the canary if some future device ever flips that.
    uint offset = wid * lsz * FETCH_PER_WI + lid;

    float sum = 0.0;
    for (int i = 0; i < FETCH_PER_WI; i++)
    {
        sum += inputBuf.data[offset];
        offset += lsz;
    }

    outputBuf.data[gid] = sum;
}
