#version 450
#extension GL_EXT_integer_dot_product : require

// INT8 dot-product compute throughput (packed dp4a).
//
// Uses dotPacked4x8AccSatEXT(int, int, int) -- the uint32-packed form of
// dotAccSatEXT.  Packed is the hardware-native path on NVIDIA, AMD and
// Intel (dp4a / V_DOT4 / IDPAS take 32-bit packed operands natively), so
// the driver doesn't insert any pack/unpack around the op.  An earlier
// i8vec4 version ran ~6x slower on NVIDIA because of exactly that
// lowering overhead.
//
// Each dotPacked4x8AccSatEXT is 4 signed INT8 multiply-adds into a 32-bit
// accumulator = 8 INT8 ops.  Nothing else runs in the loop: every
// instruction issued is one the op budget credits.
//
// The chain shape.  Three constraints have to hold at once:
//
//  - Both multiplicands may not be loop-invariant.  dp4a with fixed
//    operands is `a + n*dot(x, y)`, which a driver may and does fold: the
//    shape read 74939 GOPS on an RTX 5060 whose dp4a peak, measured
//    through CUDA's own __dp4a on the same card, is 33928.
//
//  - Nothing may run between the dots.  The obvious way to keep an operand
//    moving is to rewrite it from the accumulator (`y ^= a`), but that XOR
//    is a second dependent integer op per dot and the op budget does not
//    credit it; on an Arc A380 it cost more than half the rate (8832 GOPS
//    against 19497 for the same instruction with nothing beside it).
//
//  - All three source operands must be distinct registers.  Intel
//    Alchemist halves a three-source op that reads the same register twice
//    -- the rule the MAD chains in mad_chain.glsl are built around -- so
//    `a = dot(x, a, a)` is not the answer either.
//
// What satisfies all three: two accumulators feeding each other.  Each dot
// reads {x, the other accumulator, its own}, three distinct registers, and
// writes its own.  Every dot depends on the one before it, so this is still
// a single chain; and because the dot extracts bytes of a value that is
// itself a 32-bit accumulator, the recurrence is not affine and has no
// closed form to fold to.  v2/v4 run two and four independent copies.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Output {
    int data[];
} outputBuf;

layout(push_constant) uniform PushConstants {
    int A;
} pc;

// Sixty-four dots per trip, not sixteen.  This is the one compute-peak shader
// whose loop control competes with its own work: on NVIDIA Turing and later
// IMAD issues on the FP32 pipe, so the integer MAD chain's counter is free,
// but IDP4A is an ALU-pipe instruction and the counter's add/compare/branch sit
// in the same queue as the dots.  At 16 dots a trip that is 3 ops in 19 and a
// 5060 reads 32.4 TOPS against an architectural 41.9 (30 SMs x 64 INT32 lanes x
// 8 ops x 2.72 GHz); at 64 it is 3 in 67.  The per-work-item budget is
// unchanged -- 16 trips x 64 dots is the same 1024 dots as 64 x 16.

// Two dots, one dependent chain, no third instruction.

// clpeak-alt: -DINT8_DP_NOSAT
//
// The alt build spells the same dot without the saturate.  CUDA's __dp4a and
// PTX's dp4a.s32.s32 do not saturate and there is no saturating dp4a in the
// ISA, so OpSDotAccSat has to be lowered as the dot plus a clamp -- which the
// driver reporting the saturating form as "accelerated" does not contradict,
// since that only means it is not fully emulated.  On a 5060 the saturating
// row reads 79% of what the same card's __dp4a reaches, and this is the one
// structural difference left between the two.
//
// DOT expands to OpSDot + OpIAdd, which is one IDP4A only if the driver folds
// the add into the dot's accumulate operand.  If it does not, the alt build is
// issuing an op the budget does not credit -- but then it is *slower*, so the
// race discards it and no inflated number can come out of this.  The ceiling
// is the check: the same card's CUDA row.
#ifdef INT8_DP_NOSAT
  #define DOT(x, y, a)  (dotPacked4x8EXT(x, y) + (a))
#else
  #define DOT(x, y, a)  dotPacked4x8AccSatEXT(x, y, a)
#endif

#define STEP2(x, p, q)   p = DOT(x, q, p); \
                         q = DOT(x, p, q);
#define STEP2_4(x, p, q) STEP2(x, p, q) STEP2(x, p, q) STEP2(x, p, q) STEP2(x, p, q)
#define STEP2_8(x, p, q) STEP2_4(x, p, q) STEP2_4(x, p, q)          // 16 dots

void main()
{
    // x holds four int8 lanes packed LSB->MSB: (A, A+1, A+2, A+3).
    // int (not uint) so glslang picks the signed int32 overload of
    // dotPacked4x8AccSatEXT and emits OpSDotAccSat + PackedVectorFormat4x8Bit
    // (the native dp4a path) instead of folding back to i8vec4.
    int x = (pc.A & 0xff)
          | (((pc.A + 1) & 0xff) << 8)
          | (((pc.A + 2) & 0xff) << 16)
          | (((pc.A + 3) & 0xff) << 24);
    int lid = int(gl_LocalInvocationID.x);
    int a0 = lid;
    int a1 = lid + 4;

    // 16 outer iters * 64 dots = 1024 dots * 8 ops = 8192 ops per WI.
    for (int i = 0; i < 16; i++)
    {
        STEP2_8(x, a0, a1) STEP2_8(x, a0, a1)
        STEP2_8(x, a0, a1) STEP2_8(x, a0, a1)
    }

    outputBuf.data[gl_GlobalInvocationID.x] = a0 + a1;
}
